{
  "name": "macos-computer-use",
  "version": "0.1.0",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./dist/pi-extension/index.js"
    ]
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.19.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/public.d.ts",
      "import": "./dist/contracts/public.js"
    },
    "./pi-extension": {
      "types": "./dist/pi-extension/index.d.ts",
      "import": "./dist/pi-extension/index.js"
    }
  },
  "bin": {
    "macos-computer-use": "./dist/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check 'src/**/*.{ts,js,json}' 'tests/**/*.ts' '*.{js,ts,json}'",
    "check": "tsc -p tsconfig.json --noEmit && eslint . && prettier --check 'src/**/*.{ts,js,json}' 'tests/**/*.ts' '*.{js,ts,json}' && pnpm build && vitest run"
  },
  "dependencies": {
    "fast-xml-parser": "5.3.4",
    "typebox": "1.3.27",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@eslint/js": "9.36.0",
    "@types/node": "24.12.2",
    "eslint": "9.36.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.1",
    "vitest": "4.1.5"
  }
}
